# Copy this file to .env.local and fill in values from Supabase Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
# Use the current Supabase publishable key for browser/server auth calls.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy Supabase projects may use this instead of the publishable key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Keep these server-only values in Vercel Project Settings. Never commit values.
TRUSSLINE_ADMIN_PASSWORD=
# A single verified administrator email for passwordless sign-in (never commit an address here).
TRUSSLINE_ADMIN_OTP_EMAIL=
SUPABASE_SERVICE_ROLE_KEY=
